# Front-end host for careers.annex-technologies.com (Caddy).
#
# Chat/social crawlers (WhatsApp, Facebook, LinkedIn, X, Slack, Telegram...)
# do not run JavaScript, so for /jobs/<id> they are sent to the API's
# /share/jobs/<id> page, which returns that job's Open Graph tags. Everyone
# else gets the single-page app as usual. Googlebot is deliberately NOT in
# the list: it renders JavaScript and should index the real page.

careers.annex-technologies.com {
    root * /var/www/annex-careers/dist
    encode zstd gzip

    @job_link_bots {
        path_regexp job ^/jobs/(\d+)/?$
        header_regexp User-Agent (?i)(facebookexternalhit|facebot|whatsapp|twitterbot|linkedinbot|slackbot|telegrambot|discordbot|pinterestbot|skypeuripreview|embedly|redditbot|applebot|vkshare|quora link preview|outbrain|tumblr|bitlybot|nuzzel|xing-contenttabreceiver|mastodon|bluesky|w3c_validator)
    }
    handle @job_link_bots {
        rewrite * /share/jobs/{re.job.1}
        reverse_proxy https://annex-careers.onrender.com {
            header_up Host annex-careers.onrender.com
        }
    }

    # Long cache for hashed build assets; the share image and icons change rarely.
    @assets path /assets/* /og-image.jpg /favicon.ico /favicon.png /apple-touch-icon.png
    header @assets Cache-Control "public, max-age=604800"

    handle {
        try_files {path} /index.html
        file_server
    }
}
