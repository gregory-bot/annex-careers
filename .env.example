# ============================================
# Frontend / Site Configuration
# ============================================
FRONTEND_URL=https://careers.annex-technologies.com
SITE_URL=https://careers.annex-technologies.com
BACKEND_URL=https://api.annex-technologies.com

# Backend API base URL used by the frontend (front-end/src/lib/jobStore.ts,
# Footer.tsx). Point this at a local backend (e.g. http://localhost:8000)
# when running the API locally.
VITE_API_URL=https://api.careers.annex-technologies.com

# ============================================
# Database Configuration
# ============================================
DB_HOST=your-db-host.com
DB_PORT=5432
DB_NAME=defaultdb
DB_USER=your-db-user
DB_PASSWORD=your-db-password
DB_SSLMODE=require
DB_SCHEMA=jobs

# ============================================
# Email Service Configuration
# ============================================
BREVO_API_KEY=
RESEND_API_KEY=
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
EMAIL_FROM=noreply@annex-technologies.com
EMAIL_FROM_NAME=Annex Careers

# ============================================
# Scraper Configuration
# ============================================
SCRAPE_INTERVAL_HOURS=24
USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36

# ============================================
# Airflow Configuration
# ============================================
AIRFLOW_HOME=/path/to/airflow_home
AIRFLOW__CORE__LOAD_EXAMPLES=False
AIRFLOW__CORE__DAGS_FOLDER=/path/to/airflow_home/dags

# ============================================
# Admin auth (backend admin routes)
# ============================================
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# ============================================
# Automatic emails / integrations
# ============================================
# Hour (UTC) for the daily job-alert emails to subscribers and CV uploaders. 5 = 08:00 EAT.
JOB_ALERT_HOUR_UTC=5
# Free ReliefWeb API appname for UN/NGO consultancies (request at https://apidoc.reliefweb.int/).
RELIEFWEB_APPNAME=
# Public base URL of the API itself (used for absolute links to uploaded files in share previews
# and auto-filled TOR links). Production: https://api.careers.annex-technologies.com
API_PUBLIC_URL=
# Set to false on any extra API instance so only one scrapes and sends alert emails.
SCHEDULER_ENABLED=true
